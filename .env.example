# Public site URL (used for canonical and hreflang links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Supabase. Enables reviewer sign-in and decisions (docs/PILOT.md) and the report form.
# Only the anon key belongs here; the app never uses the service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Which listings to show: demo (production default) | pilot (all candidates; Vercel previews
# default to this) | published (only reviewer-approved claims).
# DIRECTORY_MODE=pilot

# Days before an approved claim must be re-checked (shown as "Needs re-check" after).
# REVIEW_MAX_AGE_DAYS=180
